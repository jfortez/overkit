{
  "name": "overkit-workspace",
  "private": true,
  "author": {
    "name": "Jean Caiza",
    "email": "jeanmcm@hotmail.com",
    "url": "https://github.com/jfortez"
  },
  "repository": {
    "type": "git ",
    "url": "git+https://github.com/jfortez/overkit.git"
  },
  "keywords": [
    "react",
    "reactjs",
    "overkit",
    "portal",
    "modal",
    "dialog"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=overkit && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "lib/*"
  ]
}
